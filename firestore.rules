rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados das planilhas: leitura para quem esta logado; escrita so pelo script (chave de servico)
    match /dados/planilhas {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // DSS, conquistas, equipe e classificacao das falhas: so o(s) editor(es) escreve(m)
    match /dados/estado {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in ['seu-email@empresa.com'];
    }
  }
}
